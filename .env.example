# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api
# Comma-separated. Add every origin the web app is served from.
CORS_ORIGINS=http://localhost:3000

# Swagger UI at /api/docs. Unset means "on unless NODE_ENV=production".
# Set to true to expose the schema in production, false to hide it anywhere.
# SWAGGER_ENABLED=true

# ── Database ─────────────────────────────────────────────────────────────
POSTGRES_USER=wizzapp
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=wizzapp
DATABASE_URL=postgresql://wizzapp:change-me-in-production@localhost:5432/wizzapp?schema=public

# ── Uploads ──────────────────────────────────────────────────────────────
# Where exercise videos are written. Must be a mounted volume in production,
# and must be covered by scripts/backup.sh.
UPLOAD_DIR=uploads
# Absolute origin the API is reached at — used to build video URLs.
PUBLIC_URL=http://localhost:4000

# ── Auth ─────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
# Login attempts allowed per IP per window. Raise only for testing.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_TTL_MS=60000

# ── Seeded trainer (the single pilot trainer) ────────────────────────────
SEED_TRAINER_NAME=المدرب
SEED_TRAINER_EMAIL=trainer@wizzapp.local
# Set before seeding. Generate with: openssl rand -base64 18
SEED_TRAINER_PASSWORD=replace-with-a-strong-password

# ── Demo data (development only) ─────────────────────────────────────────
# With SEED_DEMO=true the seed also creates a workout template and three
# clients with programs, nutrition plans and three weeks of daily logs, so
# every screen has something to show on a fresh checkout. Leave it unset in
# any environment holding real people's data.
SEED_DEMO=true
# The password all three demo clients share. 8 characters minimum.
SEED_DEMO_PASSWORD=replace-with-a-demo-password
